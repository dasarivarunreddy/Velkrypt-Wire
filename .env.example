# ---- Site ----
# Your public URL. Use the Vercel address until you buy a domain.
NEXT_PUBLIC_SITE_URL=https://velkrypt-wire.vercel.app
NEXT_PUBLIC_SITE_NAME=Velkrypt Wire

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (emails + newsletter) ----
RESEND_API_KEY=re_xxxxxxxxx
# Until you verify a domain in Resend, use onboarding@resend.dev (sends only to your own address).
EMAIL_FROM="Velkrypt Wire <onboarding@resend.dev>"

# ---- Stripe (paid memberships) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxx

# ---- Cron (auto news feed) ----
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Cloudflare Turnstile (bot protection, optional) ----
# Leave both empty to switch bot protection off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Free AI providers for the newsroom (add at least one) ----
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (free-tier model names change often)
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Email daily limit (Resend free plan = 100/day). Raise when you upgrade. ----
EMAIL_DAILY_LIMIT=100

# ---- Phase 4: reach ----
# Search engines: paste the verification codes from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Telegram channel posting (create a bot with @BotFather, add it as channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@yourchannel
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/yourchannel
# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_DISCORD_URL=
# Shown on the contact page and in security.txt (optional)
CONTACT_EMAIL=
# Optional free NVD key (faster CVE lookups): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
