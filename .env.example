# ---- Site ----
# Your public URL. Use the Vercel address until you buy a domain.
NEXT_PUBLIC_SITE_URL=https://velkrypt-wire.vercel.app
NEXT_PUBLIC_SITE_NAME=Velkrypt Wire

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (emails + newsletter) ----
RESEND_API_KEY=re_xxxxxxxxx
# Until you verify a domain in Resend, use onboarding@resend.dev (sends only to your own address).
EMAIL_FROM="Velkrypt Wire <onboarding@resend.dev>"

# ---- Stripe (paid memberships) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxx

# ---- Cron (auto news feed) ----
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
